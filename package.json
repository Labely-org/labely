{
  "name": "labely",
  "version": "1.0.0",
  "description": "Privacy-first, zero-setup open source annotation studio for computer vision. Works on Windows, Linux, and Web (labely.org).",
  "main": "electron/main.cjs",
  "type": "module",
  "homepage": "https://labely.org",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "desktop": "electron electron/main.cjs",
    "electron:start": "NODE_ENV=development electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:build:mac": "npm run build && electron-builder --mac"
  },
  "keywords": [
    "image-annotation",
    "computer-vision",
    "yolo",
    "yolov8",
    "yolov11",
    "coco-dataset",
    "labelme",
    "cvat",
    "bounding-box",
    "polygon-segmentation",
    "obb",
    "machine-learning",
    "dataset-tool",
    "electron",
    "react"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}